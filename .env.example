DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
# STT batch (confirmaciones habladas CONFIRM, jarvis.audio.stt) y TTS siguen en OpenAI — ver
# docs/decisions/0012-migrar-stt-en-streaming-a-speechmatics.md. La captura de comandos generales
# en streaming (jarvis.audio.realtime_stt) usa Speechmatics, clave separada:
SPEECHMATICS_API_KEY=
# Opcional, sin descomentar por default: habilitado. Descomentar y poner en false (o 0/no/off)
# para desactivar el auto-accept de colas de League of Legends
# (jarvis.league.lcu_monitor.LCUAutoAcceptMonitor).
# JARVIS_LOL_AUTO_ACCEPT=false
